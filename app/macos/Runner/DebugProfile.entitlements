<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Alpha: unsandboxed so the app can run the upstream corten-matrix
	     extract-key CLI (iMessage hardware key). Revisit before any
	     App Store / notarized release. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- iMessage (this Mac): sending through Messages.app with AppleScript
	     (needed with the hardened runtime; macOS still asks the user). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- New-chat contact picker (needed with the hardened runtime). -->
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
</dict>
</plist>
